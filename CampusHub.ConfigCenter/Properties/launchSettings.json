{
  "$schema": "https://json.schemastore.org/launchsettings.json",
  "profiles": {
    "http": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "launchBrowser": true,
      "applicationUrl": "http://localhost:5006",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "Portal__Semester": "Semester env"
      },
      "commandLineArgs": "--Notifications:Channel=\"Channel CLI\""
    },
    "https": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "launchBrowser": true,
      "applicationUrl": "https://localhost:7134;http://localhost:5006",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "Portal__Semester": "Semester env"
      },
      "commandLineArgs": "--Notifications:Channel=\"Channel CLI\""
    }
  }
}
